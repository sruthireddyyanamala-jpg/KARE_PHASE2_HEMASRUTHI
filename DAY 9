//single number
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[]=new int[n];
        int i,m=0;
        for(i=0;i<n;i++) {
            m=m^arr[i];
        }
        System.out.print("Single Number;" +m);
    }
}

//Missing number
import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[]=new int[n-1];
        int i,sum=0;
        for(i=0;i<n-1;i++) {
            sum=sum^arr[i];
        }
        int sumn=n*(n+1)/2;
        System.out.print("Missing Number;" +(sumn-sum));
    }
}

