        int temp = n,c=0,d,sum = 0;
        while (n != 0) {
        
            n = n/10;
            c++;
        }
        n=temp;
        while(n!=0) {
            d=n%10;
            sum = sum+(int)Math.pow(d,c);
            n=n/10;
        }
        if(temp==sum)
        System.out.print("Arm Strong Number");
        else
        System.out.print("Not a Arm Strong Number");
    }
}
